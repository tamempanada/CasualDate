@model IReadOnlyList<CasualDate.ViewModels.Admin.AdminUserListItemViewModel>

@{
    ViewData["Title"] = "Admin Users";
}

<section class="admin-shell">
    <p class="eyebrow">SuperAdmin</p>
    <h1>Admin Users</h1>
    <p class="soft-copy">Create accounts for trusted people who can sign in to the admin dashboard.</p>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <p class="status-message">@statusMessage</p>
    }

    <div class="admin-actions">
        <a class="primary-button" asp-controller="Users" asp-action="Create">Create Admin</a>
        <a class="secondary-button" href="/admin">Back to Dashboard</a>
    </div>

    <div class="table-shell">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>SuperAdmin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@(user.IsSuperAdmin ? "Yes" : "No")</td>
                        <td class="table-actions">
                            <form asp-controller="Users" asp-action="ToggleSuperAdmin" asp-route-id="@user.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">@(user.IsSuperAdmin ? "Remove SuperAdmin" : "Make SuperAdmin")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
