@inject CasualDate.Data.ApplicationDbContext LayoutDb
@using CasualDate.Models
@using System.Text.Json

@{
    var isAdminPage = Context.Request.Path.StartsWithSegments("/admin");
    var isStartupPage = Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/Home/Index");
    var showMusic = !isAdminPage && !isStartupPage;
    var showBackground = !isAdminPage;
    UploadedMedia? music = null;
    UploadedMedia? background = null;
    var musicTracks = new List<UploadedMedia>();
    var musicTrackData = new List<object>();
    var selectedMusicCover = "";

    if (showMusic || showBackground)
    {
        var settings = LayoutDb.GameSettings
            .OrderBy(setting => setting.Id)
            .Select(setting => new
            {
                setting.MusicMediaId,
                setting.BackgroundMediaId
            })
            .FirstOrDefault();

        if (showMusic)
        {
            musicTracks = LayoutDb.UploadedMedia
                .Where(media => media.MediaType == MediaType.Audio)
                .OrderBy(media => media.DisplayName)
                .ThenBy(media => media.Id)
                .ToList();

            music = settings?.MusicMediaId is not null
                ? musicTracks.FirstOrDefault(media => media.Id == settings.MusicMediaId)
                : null;

            music ??= musicTracks.FirstOrDefault();

            var coverIds = musicTracks
                .Select(track => track.AlbumCoverMediaId)
                .Where(id => id.HasValue)
                .Select(id => id!.Value)
                .Distinct()
                .ToList();
            var coverPaths = LayoutDb.UploadedMedia
                .Where(media => coverIds.Contains(media.Id) && media.MediaType == MediaType.Image)
                .ToDictionary(media => media.Id, media => Url.Content(media.FilePath));

            musicTrackData = musicTracks
                .Select(track =>
                {
                    var coverSrc = track.AlbumCoverMediaId.HasValue && coverPaths.TryGetValue(track.AlbumCoverMediaId.Value, out var path)
                        ? path
                        : "";

                    return new
                    {
                        id = track.Id,
                        title = track.DisplayName,
                        src = Url.Content(track.FilePath),
                        coverSrc
                    };
                })
                .Cast<object>()
                .ToList();

            if (music?.AlbumCoverMediaId is not null && coverPaths.TryGetValue(music.AlbumCoverMediaId.Value, out var selectedPath))
            {
                selectedMusicCover = selectedPath;
            }
        }

        if (showBackground && settings?.BackgroundMediaId is not null)
        {
            background = LayoutDb.UploadedMedia
                .FirstOrDefault(media => media.Id == settings.BackgroundMediaId && media.MediaType == MediaType.Image);
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Casual Date</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-shell @(background is not null ? "has-page-background" : "")"
      style="@(background is not null ? $"--page-background-image: url('{background.FilePath}');" : "")">
    <header class="top-bar">
        <a class="brand-link" asp-controller="Home" asp-action="Index">Casual Date</a>
        <nav class="main-nav" aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Menu">Menu</a>
        </nav>
    </header>

    <div class="page-frame">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-note">
        Built as a personal mini-game gift.
    </footer>

    @if (music is not null)
    {
        <div class="music-widget" data-music-widget data-music-id="@music.Id">
            <audio data-music-audio src="@Url.Content(music.FilePath)"></audio>
            <button class="music-expand-button" type="button" data-music-expand aria-label="Expand music player" hidden>♪ +</button>
            <div class="music-cover-frame">
                <img class="music-cover @(string.IsNullOrWhiteSpace(selectedMusicCover) ? "is-hidden" : "")" data-music-cover src="@selectedMusicCover" alt="" />
                <div class="music-cover-placeholder @(string.IsNullOrWhiteSpace(selectedMusicCover) ? "" : "is-hidden")" data-music-cover-placeholder>Music</div>
            </div>
            <div class="music-info">
                <span data-music-title>@music.DisplayName</span>
                <small data-music-time>0:00 / 0:00</small>
                <input class="music-seek" data-music-seek type="range" min="0" max="100" value="0" step="1" aria-label="Music position" />
                <div class="music-controls" aria-label="Music controls">
                    <button type="button" data-music-prev aria-label="Previous track">Prev</button>
                    <button class="music-toggle" type="button" data-music-toggle aria-pressed="false">Play</button>
                    <button type="button" data-music-next aria-label="Next track">Next</button>
                    <button type="button" data-music-loop aria-pressed="false">Loop</button>
                    <button type="button" data-music-picker-toggle aria-expanded="false">Pick music</button>
                    <button type="button" data-music-minimize aria-label="Minimize music player">Minimize</button>
                </div>
                <div class="music-picker" data-music-picker hidden>
                    <div class="music-picker-section">
                        <strong>Music</strong>
                        <div class="music-track-list" data-music-library></div>
                    </div>
                    <div class="music-picker-section">
                        <strong>Queue</strong>
                        <div class="music-queue" data-music-queue>Queue is empty.</div>
                    </div>
                </div>
            </div>
            <script type="application/json" data-music-library-json>@Html.Raw(JsonSerializer.Serialize(musicTrackData))</script>
        </div>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
